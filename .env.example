# Sao chép file này thành .env.local rồi điền cấu hình Firebase (Project settings → Your apps → Web app).
# Để trống VITE_FIREBASE_API_KEY → app chạy chế độ cục bộ (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
